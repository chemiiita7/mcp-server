# Copia este archivo como secrets.env JUNTO AL docker-compose.yml DEL VPS y rellénalo.
# secrets.env está en .gitignore: nunca se sube al repo y el deploy no lo toca.
#
# Ojo con el nombre: NO puede llamarse .env. El contenedor monta ./:/app y fastmcp
# auto-parsea cualquier /app/.env; además corre como uid 1000 mientras que el usuario
# del VPS es 1001, así que un .env con permisos 600 lo reventaría al arrancar.
# Con env_file lo lee docker compose en el host y solo inyecta las variables.

# Contraseña RCON del servidor de Minecraft (tools/minecraft.py)
MC_RCON_PASSWORD=
